generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  workouts  Workout[]
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workout {
  id          String     @id @default(cuid())
  name        String
  description String?
  slug        String?    @unique
  tags        String     @default("")
  sets        WorkoutSet[]
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  isPublic    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model WorkoutSet {
  id                   String        @id @default(cuid())
  order                Int
  repeatCount          Int           @default(1)
  restBetweenExercises Int           @default(0)
  restBetweenSets      Int           @default(0)
  exercises            SetExercise[]
  workout              Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutId            String
}

model SetExercise {
  id           String     @id @default(cuid())
  name         String
  workDuration Int        @default(30)
  order        Int
  set          WorkoutSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  setId        String
}
