{
  "name": "test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && node ./scripts/apply-turso-migrations.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "db:validate": "prisma validate",
    "audit": "node -e \"const {execSync}=require('node:child_process'); const out=execSync('npm audit --omit=dev --audit-level=high --json',{encoding:'utf8'}); const data=JSON.parse(out); const adv=data.vulnerabilities||{}; const high=Object.values(adv).filter(v=>v.severity==='high').length; const critical=Object.values(adv).filter(v=>v.severity==='critical').length; if(high||critical){console.error('High/critical vulnerabilities found:', {high, critical}); process.exit(1);} console.log('No high/critical vulnerabilities.');\"",
    "test:run": "NODE_ENV=test DOTENV_CONFIG_PATH=.env.test node -r dotenv/config ./node_modules/.bin/vitest run",
    "test:e2e": "DOTENV_CONFIG_PATH=.env.e2e node -r dotenv/config ./node_modules/.bin/playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run db:validate && npm run test:run && npm run test:e2e && npm run test:coverage && npm run audit",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.17.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-libsql": "^7.4.0",
    "@vercel/analytics": "^1.6.1",
    "bcryptjs": "^3.0.3",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prisma": "^7.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ],
    "src/**/*.{ts,tsx}": [
      "vitest run --passWithNoTests"
    ]
  }
}
